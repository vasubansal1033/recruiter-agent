# Copy to .env and fill in the key for the model you use.
# Never commit .env.

# Model string passed to LiteLLM. Examples:
#   gemini/gemini-2.5-flash          (default) — needs GEMINI_API_KEY
#   anthropic/claude-3-5-haiku-latest         — needs ANTHROPIC_API_KEY
#   openai/gpt-4o-mini                        — needs OPENAI_API_KEY
#   ollama/qwen2.5:7b                         — local only; set OLLAMA_API_BASE
AGENT_MODEL=gemini/gemini-2.5-flash
# AGENT_MODEL=openai/gpt-4o-mini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agents SDK tracing can use OPENAI_API_KEY. Keep off so a missing key does not spam.
OPENAI_AGENTS_DISABLE_TRACING=1

# Local Ollama only. Do not use Ollama in production hosting.
OLLAMA_API_BASE=http://localhost:11434

# Comma-separated CORS allowlist (blog widget + local Astro).
ALLOWED_ORIGINS=https://vasubansal1033.github.io,http://localhost:4321,http://127.0.0.1:4321

# Server bind. Hugging Face Spaces / Cloud Run / Render inject PORT.
PORT=8000

# Optional override. Defaults to <repo>/profile
# PROFILE_DIR=
